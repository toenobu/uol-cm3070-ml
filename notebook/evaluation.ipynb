   "id": "f0a06c84-5d43-4034-bbfc-e42dff097ec6",
   "metadata": {},
   "source": [
    "## Predict the disease class for a single image using similarity search.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "e382a2bb-8a48-4e9c-bd21-5fb73f4e9fa5",
   "metadata": {},
   "outputs": [],
   "source": [
    "from collections import Counter\n",
    "\n",
    "def predict_single_image(image, k=1):\n",
    "    \"\"\"\n",
    "    Predict the disease class for a single image using similarity search.\n",
    "\n",
    "    Args:\n",
    "        image: PIL Image or image array\n",
    "        k: Number of nearest neighbors to retrieve\n",
    "\n",
    "        Returns:\n",
    "            predicted_label: The predicted disease label\n",
    "            scores: Similarity scores\n",
    "    \"\"\"\n",
    "    # Generate embedding for the input image\n",
    "    with torch.no_grad():\n",
    "        img_embedding = model.get_image_features(**processor([image], return_tensors=\"pt\", truncation=True).to(\"cuda\"))[0].detach().cpu().numpy()\n",
    "\n",
    "    # Find nearest neighbors using FAISS\n",
    "    scores, retrieved_examples = ds.get_nearest_examples('image_embeddings', img_embedding, k=k)\n",
    "\n",
    "    neighbor_labels = retrieved_examples[\"label\"]\n",
    "        \n",
    "    label_counts = Counter(neighbor_labels)\n",
    "        \n",
    "    # The most_common(1) method returns a list of (label, count) tuples, so we access the first element and then the label.\n",
    "    predicted_label = label_counts.most_common(1)[0][0]\n",
    "\n",
    "    # Find the indices of all neighbors that have the predicted label\n",
    "    matching_indices = [i for i, label in enumerate(neighbor_labels) if label == predicted_label]\n",
    "\n",
    "    # Get the scores for only the neighbors with the predicted label\n",
    "    matching_scores = [scores[i] for i in matching_indices]\n",
    "\n",
    "    average_score = sum(matching_scores) / len(matching_scores)\n",
    "\n",
    "    return predicted_label, average_score"
   ]
  },
