    "## Create visualizations for the evaluation results."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "16449832",
   "metadata": {},
   "outputs": [],
   "source": [
    "def visualize_results(results, save_path=None):\n",
    "    \"\"\"\n",
    "    Create visualizations for the evaluation results.\n",
    "\n",
    "    Args:\n",
    "        results: Dictionary containing evaluation results\n",
    "        save_path: Optional path to save the figures\n",
    "    \"\"\"\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(15, 12))\n",
    "\n",
    "    # 1. Confusion Matrix Heatmap\n",
    "    ax1 = axes[0, 0]\n",
    "    cm = results['confusion_matrix']\n",
    "    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=ax1)\n",
    "    ax1.set_title('Confusion Matrix', fontsize=14, fontweight='bold')\n",
    "    ax1.set_xlabel('Predicted Label')\n",
    "    ax1.set_ylabel('True Label')\n",
    "\n",
    "    # 2. Per-Disease Metrics Bar Chart\n",
    "    ax2 = axes[0, 1]\n",
    "    diseases = list(results['per_class'].keys())\n",
    "    precisions = [results['per_class'][d]['precision'] for d in diseases]\n",
    "    recalls = [results['per_class'][d]['recall'] for d in diseases]\n",
    "    f1_scores = [results['per_class'][d]['f1_score'] for d in diseases]\n",
    "\n",
    "    x = np.arange(len(diseases))\n",
    "    width = 0.25\n",
    "\n",
    "    ax2.bar(x - width, precisions, width, label='Precision', alpha=0.8)\n",
    "    ax2.bar(x, recalls, width, label='Recall', alpha=0.8)\n",
    "    ax2.bar(x + width, f1_scores, width, label='F1-Score', alpha=0.8)\n",
    "\n",
    "    ax2.set_xlabel('Disease Type')\n",
    "    ax2.set_ylabel('Score')\n",
    "    ax2.set_title('Per-Disease Performance Metrics', fontsize=14, fontweight='bold')\n",
    "    ax2.set_xticks(x)\n",
    "    ax2.set_xticklabels([d[:15] for d in diseases], rotation=45, ha='right')\n",
    "    ax2.legend()\n",
    "    ax2.grid(True, alpha=0.3)\n",
    "\n",
    "    # 3. F1-Score Distribution\n",
    "    ax3 = axes[1, 0]\n",
    "    f1_values = [results['per_class'][d]['f1_score'] for d in diseases]\n",
    "    ax3.hist(f1_values, bins=20, edgecolor='black', alpha=0.7)\n",
    "    ax3.axvline(np.mean(f1_values), color='red', linestyle='--', \n",
    "               label=f'Mean: {np.mean(f1_values):.3f}')\n",
    "    ax3.set_xlabel('F1-Score')\n",
    "    ax3.set_ylabel('Number of Diseases')\n",
    "    ax3.set_title('F1-Score Distribution Across Diseases', fontsize=14, fontweight='bold')\n",
    "    ax3.legend()\n",
    "    ax3.grid(True, alpha=0.3)\n",
    "\n",
    "    # 4. Support vs F1-Score Scatter Plot\n",
    "    ax4 = axes[1, 1]\n",
    "    supports = [results['per_class'][d]['support'] for d in diseases]\n",
    "\n",
    "    scatter = ax4.scatter(supports, f1_scores, s=100, alpha=0.6, c=f1_scores, \n",
    "                        cmap='RdYlGn', edgecolors='black', linewidth=1)\n",
    "\n",
    "    # Add labels for each point\n",
    "    for i, disease in enumerate(diseases):\n",
    "        if f1_scores[i] < 0.5 or f1_scores[i] > 0.9:  # Label outliers\n",
    "            ax4.annotate(disease[:20], (supports[i], f1_scores[i]), \n",
    "                       fontsize=8, ha='center')\n",
    "\n",
    "    ax4.set_xlabel('Support (Number of Samples)')\n",
    "    ax4.set_ylabel('F1-Score')\n",
    "    ax4.set_title('F1-Score vs Sample Support', fontsize=14, fontweight='bold')\n",
    "    ax4.grid(True, alpha=0.3)\n",
    "\n",
    "    # Add colorbar\n",
    "    cbar = plt.colorbar(scatter, ax=ax4)\n",
    "    cbar.set_label('F1-Score', rotation=270, labelpad=15)\n",
    "\n",
    "    plt.tight_layout()\n",
    "\n",
    "    if save_path:\n",
    "        plt.savefig(save_path, dpi=300, bbox_inches='tight')\n",
    "        print(f\"\\nVisualization saved to: {save_path}\")\n",
    "\n",
    "    plt.show()"
   ]
