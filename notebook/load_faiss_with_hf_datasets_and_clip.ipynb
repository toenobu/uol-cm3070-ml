    "def downscale_images(image):\n",
    "  width = 200\n",
    "  ratio = (width / float(image.size[0]))\n",
    "  height = int((float(image.size[1]) * float(ratio)))\n",
    "  img = image.resize((width, height), Image.Resampling.LANCZOS)\n",
    "  return img"
   ]
