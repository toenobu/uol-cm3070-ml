    "    Print a detailed evaluation report with all metrics.\n",
    "\n",
    "    Args:\n",
    "        results: Dictionary containing evaluation results\n",
    "    \"\"\"\n",
    "    print(\"\\n\" + \"=\"*80)\n",
    "    print(\"TOMATO DISEASE DETECTION EVALUATION REPORT\")\n",
    "    print(\"=\"*80)\n",
    "\n",
    "    # Overall metrics\n",
    "    print(\"\\n📊 OVERALL PERFORMANCE METRICS:\")\n",
    "    print(\"-\"*40)\n",
    "    overall = results['overall']\n",
    "    print(f\"Accuracy:           {overall['accuracy']:.4f}\")\n",
    "    print(f\"Precision (macro):  {overall['precision_macro']:.4f}\")\n",
    "    print(f\"Recall (macro):     {overall['recall_macro']:.4f}\")\n",
    "    print(f\"F1-Score (macro):   {overall['f1_macro']:.4f}\")\n",
    "    print(f\"Precision (weighted): {overall['precision_weighted']:.4f}\")\n",
    "    print(f\"Recall (weighted):    {overall['recall_weighted']:.4f}\")\n",
    "    print(f\"F1-Score (weighted):  {overall['f1_weighted']:.4f}\")\n",
    "    print(f\"Mean Confidence:      {overall['mean_confidence']:.4f}\")\n",
    "\n",
    "    # Per-class metrics\n",
    "    print(\"\\n📋 PER-DISEASE PERFORMANCE:\")\n",
    "    print(\"-\"*80)\n",
    "\n",
    "    # Create a formatted table\n",
    "    headers = [\"Disease\", \"Precision\", \"Recall\", \"F1-Score\", \"Support\", \"TP\", \"FP\", \"FN\"]\n",
    "\n",
    "    # Print headers\n",
    "    print(f\"{'Disease':<35} {'Precision':>10} {'Recall':>10} {'F1-Score':>10} {'Support':>8}\")\n",
    "    print(\"-\"*80)\n",
    "\n",
    "    # Sort diseases by F1-score for better readability\n",
    "    sorted_diseases = sorted(results['per_class'].items(),\n",
    "                            key=lambda x: x[1]['f1_score'],\n",
    "                            reverse=True)\n",
    "\n",
    "    for disease_name, metrics in sorted_diseases:\n",
    "        # Truncate long disease names for display\n",
    "        display_name = disease_name[:32] + \"...\" if len(disease_name) > 35 else disease_name\n",
    "        print(f\"{display_name:<35} {metrics['precision']:>10.4f} \"\n",
    "              f\"{metrics['recall']:>10.4f} {metrics['f1_score']:>10.4f} \"\n",
    "              f\"{metrics['support']:>8}\")\n",
    "\n",
    "    # Identify best and worst performing diseases\n",
    "    print(\"\\n🏆 BEST PERFORMING DISEASES:\")\n",
    "    print(\"-\"*40)\n",
    "    top_3 = sorted_diseases[:3]\n",
    "    for i, (disease, metrics) in enumerate(top_3, 1):\n",
    "        print(f\"{i}. {disease}: F1={metrics['f1_score']:.4f}\")\n",
    "\n",
    "    print(\"\\n⚠️  DISEASES NEEDING IMPROVEMENT:\")\n",
    "    print(\"-\"*40)\n",
    "    bottom_3 = sorted_diseases[-3:]\n",
    "    for i, (disease, metrics) in enumerate(bottom_3, 1):\n",
    "        print(f\"{i}. {disease}: F1={metrics['f1_score']:.4f}\")\n"
   ]
  },
