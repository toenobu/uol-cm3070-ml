   "source": [
    "## Evaluate the model on the entire test set and compute metrics for each disease."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "ad0be401",
   "metadata": {},
   "outputs": [],
   "source": [
    "disease_classes = [\n",
    "    'Bacterial_spot',\n",
    "    'Early_blight',\n",
    "    'Late_blight',\n",
    "    'Leaf_Mold',\n",
    "    'Septoria_leaf_spot',\n",
    "    'Tomato_Yellow_Leaf_Curl_Virus',\n",
    "    'Tomato_mosaic_virus',\n",
    "    'Healthy'\n",
    "]\n",
    "\n",
    "# Create label to disease name mapping\n",
    "label_to_disease = {i: disease for i, disease in enumerate(disease_classes)}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "262b0fdc",
   "metadata": {},
   "outputs": [],
   "source": [
    "def calculate_metrics(y_true, y_pred, confidence_scores):\n",
    "    \"\"\"\n",
    "    Calculate comprehensive metrics for the evaluation.\n",
    "\n",
    "    Args:\n",
    "        y_true: True labels\n",
    "        y_pred: Predicted labels\n",
    "        confidence_scores: Confidence scores for predictions\n",
    "\n",
    "    Returns:\n",
    "        Dictionary containing all calculated metrics\n",
    "    \"\"\"\n",
    "    results = {}\n",
    "\n",
    "    # Overall metrics\n",
    "    results['overall'] = {\n",
    "        'accuracy': np.mean(y_true == y_pred),\n",
    "        'precision_macro': precision_score(y_true, y_pred, average='macro', zero_division=0),\n",
    "        'recall_macro': recall_score(y_true, y_pred, average='macro', zero_division=0),\n",
    "        'f1_macro': f1_score(y_true, y_pred, average='macro', zero_division=0),\n",
    "        'precision_weighted': precision_score(y_true, y_pred, average='weighted', zero_division=0),\n",
    "        'recall_weighted': recall_score(y_true, y_pred, average='weighted', zero_division=0),\n",
    "        'f1_weighted': f1_score(y_true, y_pred, average='weighted', zero_division=0),\n",
    "        'mean_confidence': np.mean(confidence_scores)\n",
    "    }\n",
    "\n",
    "    # Per-class metrics\n",
    "    results['per_class'] = {}\n",
    "\n",
    "    # Get unique labels in the predictions and true labels\n",
    "    unique_labels = np.unique(np.concatenate([y_true, y_pred]))\n",
    "\n",
    "    for label in unique_labels:\n",
    "        # Create binary arrays for this specific class\n",
    "        y_true_binary = (y_true == label).astype(int)\n",
    "        y_pred_binary = (y_pred == label).astype(int)\n",
    "\n",
    "        # Calculate metrics for this class\n",
    "        disease_name = label_to_disease.get(label, f\"Unknown_{label}\")\n",
    "\n",
    "        # Count support (number of actual instances of this class)\n",
    "        support = np.sum(y_true == label)\n",
    "\n",
    "        # Calculate true positives, false positives, false negatives\n",
    "        tp = np.sum((y_true == label) & (y_pred == label))\n",
    "        fp = np.sum((y_true != label) & (y_pred == label))\n",
    "        fn = np.sum((y_true == label) & (y_pred != label))\n",
    "        \n",
    "        # Calculate precision, recall, and F1\n",
    "        precision = tp / (tp + fp) if (tp + fp) > 0 else 0.0\n",
    "        recall = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n",
    "        f1 = 2 * (precision * recall) / (precision + recall) if (precision + recall) > 0 else 0.0\n",
    "        \n",
    "        results['per_class'][disease_name] = {\n",
    "            'precision': precision,\n",
    "            'recall': recall,\n",
    "            'f1_score': f1,\n",
    "            'support': support,\n",
    "            'true_positives': tp,\n",
    "            'false_positives': fp,\n",
    "            'false_negatives': fn\n",
    "        }\n",
    "    \n",
    "    # Confusion matrix\n",
    "    results['confusion_matrix'] = confusion_matrix(y_true, y_pred)\n",
    "        \n",
    "    # Store raw predictions for further analysis\n",
    "    results['raw_data'] = {\n",
    "        'y_true': y_true,\n",
    "        'y_pred': y_pred,\n",
    "        'confidence_scores': confidence_scores\n",
    "    }\n",
    "    \n",
    "    return results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "31e13f98-13a0-444b-ad0b-210682caf676",
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_test_set(sample_size=None):\n",
    "    \"\"\"\n",
    "    Evaluate the model on the entire test set and compute metrics for each disease.\n",
    "    \n",
    "    Args:\n",
    "        sample_size: If specified, only evaluate on a sample of the test set\n",
    "        \n",
    "    Returns:\n",
    "        results: Dictionary containing all evaluation metrics\n",
    "    \"\"\"\n",
    "    print(f\"\\nEvaluating ...\")\n",
    "\n",
    "    # If sample_size is specified, take a random sample\n",
    "    if sample_size and sample_size < len(ds_test):\n",
    "        indices = np.random.choice(len(ds_test), sample_size, replace=False)\n",
    "        test_dataset = ds_test.select(indices)\n",
    "    else:\n",
    "        test_dataset = ds_test\n",
    "\n",
    "    y_true = []\n",
    "    y_pred = []\n",
    "    confidence_scores = []\n",
    "\n",
    "    print(f\"Processing {len(test_dataset)} images...\")\n",
    "\n",
    "    # Iterate through test images and make predictions\n",
    "    for idx in tqdm(range(len(test_dataset))):\n",
    "        # Get the true label\n",
    "        true_label = test_dataset[idx]['label']\n",
    "        y_true.append(true_label)\n",
    "\n",
    "        # Get the image\n",
    "        image = test_dataset[idx]['image']\n",
    "\n",
    "        # Make prediction\n",
    "        predicted_label, score = predict_single_image(image, k=5)\n",
    "        y_pred.append(predicted_label)\n",
    "        confidence_scores.append(score)\n",
    "\n",
    "    # Convert to numpy arrays for easier manipulation\n",
    "    y_true = np.array(y_true)\n",
    "    y_pred = np.array(y_pred)\n",
    "    confidence_scores = np.array(confidence_scores)\n",
    "\n",
    "    # Calculate metrics\n",
    "    results = calculate_metrics(y_true, y_pred, confidence_scores)\n",
    "\n",
    "    return results\n"
   ]
  },
